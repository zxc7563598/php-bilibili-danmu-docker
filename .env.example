# ============================================
# php-bilibili-danmu Docker 部署配置文件
# 复制此文件为 .env 后按需修改
#   cp .env.example .env
# ============================================

# MySQL root 密码（仅在自动创建数据库用户时使用）
MYSQL_ROOT_PASSWORD=init0925

# MySQL 端口映射（宿主机端口:容器3306）
MYSQL_PORT=3307

# Nginx 主站端口映射（宿主机端口:容器80）
NGINX_PORT=7777

# 商城前端端口映射（宿主机端口:容器5176）
SHOP_PORT=5177
